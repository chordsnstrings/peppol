// ARKS e-Invoicing — multi-tenant server schema.
// Domain data (invoices, customers, entities…) is stored as tenant-scoped JSON
// documents in `Record`, so the existing client keeps its object-store shape while
// gaining server-side persistence + org isolation. Auth and secrets are typed tables.
//
// PostgreSQL. Dev runs a local cluster in-container; production points
// DATABASE_URL at managed Postgres — the app code and migrations are identical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  meta         UserMeta[]
}

model Organization {
  id              String       @id @default(cuid())
  name            String
  slug            String
  defaultLocale   String       @default("en")
  status          String       @default("active") // active | suspended | readonly
  suspendedReason String?
  createdAt       DateTime     @default(now())
  memberships     Membership[]
}

/// A platform operator (super admin). Global, NOT an org Membership role. The
/// PLATFORM_ADMINS env allowlist is the break-glass root and bootstraps rows here.
model PlatformAdmin {
  userId    String   @id
  role      String   @default("support") // super | support | read_only
  addedBy   String?
  createdAt DateTime @default(now())
}

/// Append-only log of every privileged platform-admin read/action. This is what
/// makes cross-tenant access defensible.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminEmail  String
  action      String
  targetOrgId String?
  targetId    String?
  metadata    String? // JSON — before/after, params
  reason      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetOrgId])
  @@index([adminUserId])
}

/// Platform feature flags / kill switches. Global or per-org scope.
model FeatureFlag {
  key       String   @id // e.g. "signups_frozen" or "org:<id>:readonly"
  value     String   @default("true") // JSON or scalar
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String       @default("OWNER")
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Generic tenant-scoped document store. One row per domain object.
/// Primary key is (store, id): the same id may legitimately exist in two stores
/// without colliding — a record is identified by its store *and* id.
model Record {
  id        String
  orgId     String
  store     String
  entityId  String?
  invoiceId String?
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([store, id])
  @@index([orgId, store])
  @@index([orgId, store, entityId])
  @@index([orgId, invoiceId])
}

/// Per-user preferences (current entity, locale, notification prefs, API keys…).
model UserMeta {
  userId String
  key    String
  data   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// A document transmission through the Peppol gateway. Looked up by gatewayRef
/// on inbound webhooks (no session), so it carries orgId + invoiceId to route
/// the status update back to the right tenant's invoice.
model Transmission {
  id              String    @id @default(cuid())
  orgId           String
  invoiceId       String
  gatewayRef      String    @unique
  idempotencyKey  String    @unique
  driver          String
  exchangeStatus  String    @default("SUBMITTED")
  reportingStatus String    @default("SUBMITTED")
  ublXml          String
  tddXml          String
  error           String?
  lastEventAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
  @@index([invoiceId])
}

/// A payment attempt/collection against an invoice. `id` doubles as the public
/// pay-link token. Looked up by providerRef on gateway webhooks (no session).
model Payment {
  id          String    @id @default(cuid())
  orgId       String
  kind        String    @default("invoice") // invoice | subscription
  invoiceId   String? // null for subscription payments
  tier        String? // subscription tier when kind = subscription
  provider    String
  providerRef String?
  amountMinor Int
  currency    String
  status      String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | EXPIRED
  method      String?
  paymentUrl  String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId])
  @@index([invoiceId])
  @@index([providerRef])
}

/// The tenant's current billing plan. One row per org.
model OrgBilling {
  orgId                  String    @id
  plan                   String    @default("FREE_MANDATE") // legacy analytics/allowance (not the paywall)
  allowanceOverride      Int? // operator comp: overrides the plan's included exchanges
  // Subscription — the paywall. Entitlement to transmit to the FTA derives ONLY
  // from these fields (server-authoritative, never client-writable).
  subStatus              String    @default("trialing") // trialing | active | grace | canceled | none
  subTier                String? // MONTHLY | SEMIANNUAL | ANNUAL
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  graceEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  providerCustomerId     String?
  providerSubscriptionId String?
  lastPaymentAt          DateTime?
  dunningStage           Int       @default(0) // which reminder emails have been sent
  updatedAt              DateTime  @updatedAt
}

/// One billable exchange event, written when an invoice is first transmitted.
/// Idempotent per (invoiceId, kind) so re-sends never double-count. Usage is a
/// COUNT over these — the authoritative meter behind the billing page.
model UsageEvent {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  invoiceId String
  kind      String   @default("EXCHANGE")
  year      Int
  createdAt DateTime @default(now())

  @@unique([invoiceId, kind])
  @@index([orgId, entityId, year])
}

/// OAuth 2.1 client, created via Dynamic Client Registration (RFC 7591) so MCP
/// clients (Claude, ChatGPT, Gemini) can self-register and sign in. Public
/// (PKCE) clients have no secret.
model OAuthClient {
  id              String   @id // client_id
  secretHash      String? // null for public PKCE clients
  name            String
  redirectUris    String // JSON array
  grantTypes      String   @default("authorization_code,refresh_token")
  tokenAuthMethod String   @default("none")
  createdAt       DateTime @default(now())
}

/// A short-lived authorization code (PKCE). Stored hashed; single-use.
model OAuthAuthCode {
  codeHash      String    @id
  clientId      String
  orgId         String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String    @default("mcp")
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

/// A refresh token (opaque, stored hashed, revocable, rotated on use).
model OAuthRefreshToken {
  tokenHash String    @id
  clientId  String
  orgId     String
  userId    String
  scope     String    @default("mcp")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Idempotency ledger for inbound webhooks — dedup key is a hash of the source
/// + raw signed body, so a replayed (even validly-signed) webhook is a no-op.
model ProcessedWebhook {
  id        String   @id // sha256(source + rawBody)
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A programmatic API key for the public /api/v1 REST API. Only the SHA-256
/// hash is stored; the plaintext is shown once at creation. Scoped to one org.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId])
}

/// Encrypted OAuth tokens for accounting integrations. Server-only, per tenant.
model IntegrationToken {
  id              String    @id // == Connection id held by the client
  orgId           String
  provider        String
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  meta            String? // JSON: providerAccountId, apiDomain, etc.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
}

/**
 * ══════════════════════════════════════════════════════════════════════════
 * LEDGER CORE — double-entry general ledger.
 * The invariants that make this an accounting system rather than a table of
 * rows are enforced by the DATABASE, not by application code (see the raw SQL
 * in the accompanying migration): entries balance to zero per currency, posted
 * entries are immutable (correction is reversal-only), and nothing posts into
 * a closed period. Amounts are signed integer minor units — debit positive,
 * credit negative — so "balanced" is literally SUM() = 0.
 * ══════════════════════════════════════════════════════════════════════════
 */

/// A set of books for a legal entity. Multi-book from day one (statutory / tax /
/// management); every entity ships with one PRIMARY book. Shipping the column now
/// avoids the retrofit that NetSuite charges Professional Services to perform.
model Book {
  id                   String           @id @default(cuid())
  orgId                String
  entityId             String
  code                 String           @default("PRIMARY")
  name                 String
  kind                 String           @default("PRIMARY") // PRIMARY | TAX | MGMT
  functionalCurrency   String           @default("AED")
  presentationCurrency String           @default("AED")
  isDefault            Boolean          @default(false)
  createdAt            DateTime         @default(now())
  entries              JournalEntry[]
  balances             AccountBalance[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId])
}

/// Chart of accounts. One chart per legal entity, shared across that entity's books.
model Account {
  id                String              @id @default(cuid())
  orgId             String
  entityId          String
  code              String
  name              String
  nameAr            String?
  type              String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  subtype           String? // BANK | AR | AP | VAT_INPUT | VAT_OUTPUT | RETAINED_EARNINGS | ...
  parentId          String?
  parent            Account?            @relation("AccountTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Account[]           @relation("AccountTree")
  /// Header accounts roll up but cannot be posted to.
  isPostable        Boolean             @default(true)
  /// Control accounts (AR/AP/VAT/bank) are owned by their subledger — manual journals are refused.
  isControl         Boolean             @default(false)
  /// Restrict postings to a single currency (bank accounts).
  currency          String?
  /// Dimension code that must be supplied on every posting to this account.
  requiresDimension String?
  status            String              @default("active") // active | archived
  createdAt         DateTime            @default(now())
  lines             JournalLine[]
  balances          AccountBalance[]
  bankLines         BankStatementLine[] @relation("BankLines")

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, type])
  @@index([parentId])
}

model FiscalYear {
  id       String             @id @default(cuid())
  orgId    String
  entityId String
  label    String
  startsOn DateTime           @db.Date
  endsOn   DateTime           @db.Date
  status   String             @default("open") // open | closed
  periods  AccountingPeriod[]

  @@unique([orgId, entityId, label])
  @@index([orgId, entityId])
}

/// The fiscal calendar. Without this there is no close, and no way to stop a
/// tenant back-dating a journal into a filed VAT quarter.
model AccountingPeriod {
  id           String           @id @default(cuid())
  orgId        String
  entityId     String
  fiscalYearId String
  fiscalYear   FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  seq          Int
  label        String
  startsOn     DateTime         @db.Date
  endsOn       DateTime         @db.Date
  /// open → soft_closed (reopenable) → hard_closed → locked (statutory, never reopens)
  status       String           @default("open")
  isAdjustment Boolean          @default(false)
  closedAt     DateTime?
  /// Who last moved this period's status. Locking is the one irreversible act
  /// in the product and it recorded when but never who. NULL means the move
  /// predates the column, or the period was never closed.
  closedBy     String?
  entries      JournalEntry[]
  balances     AccountBalance[]

  @@unique([orgId, entityId, label])
  @@index([orgId, entityId, startsOn, endsOn])
}

/// N dimensions, normalised — not two hard-coded columns. Xero's two-dimension
/// cap is its most-complained-about reporting constraint; this is free now and a
/// rewrite later.
model Dimension {
  id         String           @id @default(cuid())
  orgId      String
  code       String // COST_CENTRE | PROJECT | DEPARTMENT | BRANCH | ...
  name       String
  isRequired Boolean          @default(false)
  status     String           @default("active")
  values     DimensionValue[]

  @@unique([orgId, code])
}

model DimensionValue {
  id          String                 @id @default(cuid())
  orgId       String
  dimensionId String
  dimension   Dimension              @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  code        String
  name        String
  status      String                 @default("active")
  tags        JournalLineDimension[]

  @@unique([dimensionId, code])
  @@index([orgId])
}

model JournalEntry {
  id           String           @id @default(cuid())
  orgId        String
  entityId     String
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Restrict)
  periodId     String
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  series       String           @default("GJ")
  number       String
  entryDate    DateTime         @db.Date
  /// When the document falls due, where it has terms. Ageing without it can
  /// only assume everyone pays on the same terms, which nags a customer on
  /// sixty days from the thirty-first.
  dueDate      DateTime?        @db.Date
  postedAt     DateTime?
  status       String           @default("draft") // draft | posted | reversed
  memo         String?
  /// Where the posting came from — manual, or a subledger document.
  source       String           @default("manual")
  sourceType   String?
  sourceId     String?
  /// Idempotency key for machine posting; a retry must not double-post.
  externalKey  String?
  /// The document this entry settles, when it settles one — a receipt names the
  /// invoice it pays. Open-item ageing nets a document's postings by this, so
  /// without it a paid invoice keeps showing as outstanding forever.
  settlesId    String?
  reversalOfId String?
  reversalOf   JournalEntry?    @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals    JournalEntry[]   @relation("EntryReversal")
  /// Provenance as a first-class column, not an afterthought log.
  actorType    String           @default("HUMAN") // HUMAN | RULE | MODEL | AGENT | INTEGRATION
  actorId      String?
  createdAt    DateTime         @default(now())
  lines        JournalLine[]

  @@unique([orgId, entityId, bookId, series, number])
  @@unique([orgId, externalKey])
  @@index([orgId, entityId, periodId])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, settlesId])
  @@index([orgId, entityId, entryDate])
}

/// Signed minor units: debit > 0, credit < 0. Three currency concepts on every
/// line, with the rate captured at posting time.
model JournalLine {
  id                    String                 @id @default(cuid())
  orgId                 String
  entryId               String
  entry                 JournalEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  lineNo                Int
  accountId             String
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// The open item this line settles, where one entry settles several.
  /// `JournalEntry.settlesId` can only name one document, so a batch payment
  /// posted as a single entry would leave every bill but the first showing as
  /// outstanding — which is how a supplier gets paid twice. Line-level
  /// settlement is what lets one entry discharge many.
  settlesId             String?
  txnCurrency           String
  txnAmountMinor        BigInt
  fxRate                Decimal                @default(1) @db.Decimal(20, 10)
  functionalCurrency    String
  functionalAmountMinor BigInt
  /// The tax treatment this line was raised under, carried from the document.
  /// The VAT return groups by it, so the return is computed from the ledger
  /// rather than from a second pass over the documents — the two can then
  /// never disagree with each other.
  taxCode               String?
  /// Emirate of supply. The FTA's VAT 201 splits standard-rated supplies by
  /// emirate, and that is only knowable at the moment of posting.
  taxEmirate            String?
  memo                  String?
  dimensions            JournalLineDimension[]

  @@unique([entryId, lineNo])
  @@index([orgId, accountId])
  @@index([entryId])
  @@index([orgId, taxCode])
  @@index([orgId, settlesId])
}

model JournalLineDimension {
  id          String         @id @default(cuid())
  lineId      String
  line        JournalLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  dimensionId String
  valueId     String
  value       DimensionValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@unique([lineId, dimensionId])
  @@index([valueId])
}

/// Period-anchored balance cache. A balance is NEVER computed by summing the
/// whole ledger; it is maintained incrementally at post time and anchored per period.
model AccountBalance {
  id           String           @id @default(cuid())
  orgId        String
  entityId     String
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodId     String
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  currency     String
  openingMinor BigInt           @default(0)
  debitMinor   BigInt           @default(0)
  creditMinor  BigInt           @default(0)
  closingMinor BigInt           @default(0)
  updatedAt    DateTime         @updatedAt

  @@unique([bookId, accountId, periodId, currency])
  @@index([orgId, entityId, periodId])
}

/// Gapless document numbering, allocated inside the posting transaction with an
/// atomic UPDATE … RETURNING. Replaces the client-side read-modify-write that
/// hands two concurrent users the same invoice number.
model DocumentSequence {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  scope     String
  /// May carry {YYYY} or {YY}, expanded when a number is issued.
  prefix    String   @default("")
  nextNo    Int      @default(1)
  padding   Int      @default(5)
  updatedAt DateTime @updatedAt
  /// Whether the counter goes back to 1 when a new financial year opens. Only
  /// true where the prefix names the year — a check constraint keeps it so,
  /// because a restart inside a format that does not name the year reissues
  /// last year's references.
  restartYearly Boolean @default(false)
  /// The financial year the counter is currently inside, as that year's start
  /// date. Compared at allocation time, inside the same statement that takes
  /// the number, so two postings that open a new year cannot both take 1.
  cycleStart    DateTime? @db.Date

  @@unique([orgId, entityId, scope])
}

/// A line as the bank reported it. Kept separate from the ledger on purpose:
/// the bank's record and ours are two independent accounts of the same events,
/// and reconciliation is the act of comparing them. Merging them into one table
/// would destroy the very difference the control depends on.
model BankStatementLine {
  id            String    @id @default(cuid())
  orgId         String
  entityId      String
  /// The ledger account this statement belongs to (a 1010-style bank account).
  accountId     String
  account       Account   @relation("BankLines", fields: [accountId], references: [id], onDelete: Restrict)
  postedOn      DateTime  @db.Date
  description   String
  reference     String?
  /// Signed minor units, debit-positive: money in is positive.
  amountMinor   BigInt
  currency      String
  /// Running balance the bank reported after this line, when the file gives one.
  balanceMinor  BigInt?
  /// Stable hash of the bank's own fields — re-importing an overlapping file
  /// must not duplicate lines, and banks rarely give a usable unique id.
  fingerprint   String
  importBatch   String
  /// The journal line this was matched to, once someone agrees they are the
  /// same event.
  matchedLineId String?
  matchedAt     DateTime?
  matchedBy     String?
  status        String    @default("unmatched") // unmatched | matched | ignored
  createdAt     DateTime  @default(now())

  @@unique([orgId, accountId, fingerprint])
  @@index([orgId, entityId, accountId, status])
  @@index([orgId, importBatch])
  @@index([matchedLineId])
}

/// A capitalised asset and the schedule by which it is written down.
///
/// The asset is not the journal entry. Depreciation for a month is posted once
/// and never recomputed, because a schedule that recalculates history would
/// silently rewrite prior periods every time an estimate changed — and a
/// change in estimate is prospective under IAS 16, not retrospective.
model FixedAsset {
  id               String             @id @default(cuid())
  orgId            String
  entityId         String
  code             String
  name             String
  nameAr           String?
  category         String             @default("EQUIPMENT")
  acquiredOn       DateTime           @db.Date
  /// What it cost, in minor units of the book's functional currency.
  costMinor        BigInt
  /// What it is expected to be worth at the end of its life.
  residualMinor    BigInt             @default(0)
  /// Straight line, or reducing balance at `ratePercent`.
  method           String             @default("STRAIGHT_LINE")
  usefulLifeMonths Int
  ratePercent      Decimal?           @db.Decimal(6, 3)
  /// Where the asset, its accumulated depreciation and the charge live.
  assetAccount     String             @default("1500")
  accumAccount     String             @default("1590")
  expenseAccount   String             @default("6600")
  /// Depreciation already posted, kept as a running figure so a run never has
  /// to re-derive history it did not create.
  accumulatedMinor BigInt             @default(0)
  /// The last period depreciated, as YYYY-MM. A run is idempotent on it.
  depreciatedTo    String?
  status           String             @default("active") // active | disposed | written_off
  disposedOn       DateTime?          @db.Date
  proceedsMinor    BigInt?
  notes            String?
  /// The revaluation surplus held in equity for this asset (IAS 16.39). Kept
  /// per asset because the split of a later decrease depends on this asset's
  /// own surplus, not on the entity's total.
  surplusMinor     BigInt             @default(0)
  /// Impairment charged to profit for this asset and not yet reversed. A later
  /// increase reverses that first (IAS 36.117) before anything reaches equity.
  impairedMinor    BigInt             @default(0)
  /// The date the current cost basis starts depreciating from. Nil until a
  /// revaluation restates the cost — after which depreciation is charged on
  /// the revalued amount over the REMAINING life (IAS 16.31), not on the
  /// original schedule again.
  basisFrom        DateTime?          @db.Date
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  revaluations     AssetRevaluation[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// An item held in stock, with its running quantity and value.
///
/// Both are carried on the row rather than summed from movements. Stock
/// valuation is a running calculation — weighted average cost depends on the
/// order receipts and issues happened in, so it cannot be re-derived from a set
/// of rows without replaying them, and replaying them would let a backdated
/// receipt silently rewrite the cost of goods already sold.
model InventoryItem {
  id                String              @id @default(cuid())
  orgId             String
  entityId          String
  sku               String
  name              String
  nameAr            String?
  uom               String              @default("EA")
  /// WEIGHTED_AVERAGE | FIFO. IAS 2.25 permits either, and requires the same
  /// one to be used for all inventories of a similar nature — so it is a
  /// decision recorded per item rather than a setting applied globally.
  costMethod        String              @default("WEIGHTED_AVERAGE")
  /// Net realisable value per whole unit, where it has been assessed. IAS 2.9
  /// carries stock at the lower of cost and this; nil means never assessed,
  /// which is different from an assessment of nothing.
  nrvMinor          BigInt?
  /// Quantity in thousandths, so 1.5 kg is 1500. Stock is not always whole.
  quantityMilli     BigInt              @default(0)
  /// What that quantity is carried at, in minor units.
  valueMinor        BigInt              @default(0)
  stockAccount      String              @default("1200")
  cogsAccount       String              @default("5000")
  varianceAccount   String              @default("5300")
  status            String              @default("active")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  movements         InventoryMovement[]
  layers            InventoryLayer[]
  batches           StockBatch[]
  /// Below this, the item needs ordering. Nil means nobody has set one, which
  /// is different from a level of nothing.
  reorderLevelMilli BigInt?
  /// Where this item is normally kept.
  defaultLocationId String?

  @@unique([orgId, entityId, sku])
  @@index([orgId, entityId, status])
}

/// One movement of stock. Append-only: a correction is another movement, never
/// an edit, for the same reason a posted journal entry is never edited.
model InventoryMovement {
  id                String        @id @default(cuid())
  orgId             String
  itemId            String
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  movedOn           DateTime      @db.Date
  /// LANDED_COST carries value with no quantity: freight and duty landing on
  /// stock already received (IAS 2.10).
  kind              String // RECEIPT | ISSUE | ADJUSTMENT | WRITE_OFF | LANDED_COST
  /// Signed thousandths: a receipt is positive, an issue negative.
  quantityMilli     BigInt
  /// Signed minor units, matching the quantity's direction.
  valueMinor        BigInt
  /// Weighted average cost per whole unit after this movement, in minor units.
  unitCostMinor     BigInt
  /// Running figures after this movement, so a movement can be read on its own.
  balanceQtyMilli   BigInt
  balanceValueMinor BigInt
  reference         String?
  memo              String?
  entryId           String?
  /// Where the stock moved from or to.
  locationId        String?
  /// The batch or serial this movement was of.
  batchId           String?
  createdAt         DateTime      @default(now())

  @@index([orgId, itemId, movedOn])
  @@index([entryId])
}

/// An employee, for payroll and end-of-service benefits.
model Employee {
  id               String        @id @default(cuid())
  orgId            String
  entityId         String
  code             String
  name             String
  nameAr           String?
  emiratesId       String?
  /// MOL personal id and routing code, required by the WPS salary information file.
  molPersonId      String?
  routingCode      String?
  iban             String?
  joinedOn         DateTime      @db.Date
  leftOn           DateTime?     @db.Date
  /// Unlimited contracts accrue gratuity differently from limited ones.
  contractType     String        @default("UNLIMITED")
  /// ISO country code, where it is known. Recorded for the WPS file and for
  /// context; it does NOT decide the pension scheme, because eligibility is a
  /// legal fact about the person rather than something a passport field
  /// settles — a GCC national may or may not be enrolled, and a UAE national
  /// may be registered late.
  nationality      String?
  /// NONE | GPSSA | GCC_HOME_STATE
  ///
  /// This is the field that matters. Article 51 of Federal Decree-Law 33/2021
  /// gives end-of-service gratuity to the *foreign* worker; a UAE national is
  /// covered by the pension scheme under Federal Law 7/1999 instead, and
  /// accruing both would provide for the same service twice.
  pensionScheme    String        @default("NONE")
  basicMinor       BigInt
  housingMinor     BigInt        @default(0)
  transportMinor   BigInt        @default(0)
  otherMinor       BigInt        @default(0)
  /// Annual leave in calendar days a full year of service earns. Federal
  /// Decree-Law 33/2021 Article 29 gives 30 days after a year of service and
  /// two working days a month between six months and a year; a contract may
  /// give more, never less.
  leaveDaysPerYear Int           @default(30)
  status           String        @default("active")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  payslips         Payslip[]
  leave            LeaveRecord[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// Leave taken, or bought back. Entitlement is not stored: it is a function of
/// service and the contract, and a stored entitlement is a figure that stops
/// agreeing with the joining date the moment either changes.
model LeaveRecord {
  id         String   @id @default(cuid())
  orgId      String
  entityId   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// ANNUAL | SICK | UNPAID | MATERNITY | PARENTAL | HAJJ | COMPASSIONATE | ENCASHED
  kind       String   @default("ANNUAL")
  startsOn   DateTime @db.Date
  endsOn     DateTime @db.Date
  /// Days in tenths, so half a day is 5. Leave is taken in halves, not thirds.
  daysTenth  Int
  /// Paid at the time, as annual leave is; unpaid leave earns no entitlement.
  paid       Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())

  @@index([orgId, entityId, employeeId, startsOn])
}

/// The untaken-leave provision posted at a period end. Kept per period, because
/// the charge for a month is the movement between two dates and a running
/// balance cannot be asked what last month's provision was.
model LeaveProvision {
  id           String   @id @default(cuid())
  orgId        String
  entityId     String
  period       String
  /// The liability at the end of the period.
  balanceMinor BigInt
  /// The movement charged to profit for the period.
  chargeMinor  BigInt
  /// Days of untaken leave behind that liability, in tenths.
  daysTenth    Int
  entryId      String?
  createdAt    DateTime @default(now())

  @@unique([orgId, entityId, period])
  @@index([orgId, entityId])
}

/// One employee's pay for one month. Append-only once posted.
model Payslip {
  id              String   @id @default(cuid())
  orgId           String
  entityId        String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  period          String // YYYY-MM
  basicMinor      BigInt
  allowancesMinor BigInt   @default(0)
  overtimeMinor   BigInt   @default(0)
  deductionsMinor BigInt   @default(0)
  netMinor        BigInt
  /// Gratuity accrued for this month, charged to the provision. Nil for an
  /// employee in a pension scheme: Article 51 gives the gratuity to the
  /// foreign worker, and providing for both would cover the same service
  /// twice.
  gratuityMinor   BigInt   @default(0)
  /// Withheld from the employee and owed to the pension authority.
  pensionEmployeeMinor BigInt @default(0)
  /// The employer's own share, which is a cost of employment rather than a
  /// deduction from pay.
  pensionEmployerMinor BigInt @default(0)
  status          String   @default("draft") // draft | posted | paid
  entryId         String?
  createdAt       DateTime @default(now())

  @@unique([orgId, employeeId, period])
  @@index([orgId, entityId, period])
}

/// A budget figure for one account in one period.
model BudgetLine {
  id          String   @id @default(cuid())
  orgId       String
  entityId    String
  /// Names a scenario, so last year's plan and this year's forecast coexist.
  scenario    String   @default("BUDGET")
  fiscalYear  String
  period      String // YYYY-MM
  accountCode String
  amountMinor BigInt
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, entityId, scenario, period, accountCode])
  @@index([orgId, entityId, scenario, fiscalYear])
}

/// A period-end exchange rate, used to revalue foreign-currency balances.
model FxRate {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  currency  String
  /// Rate to the book's functional currency.
  rate      Decimal  @db.Decimal(20, 10)
  rateDate  DateTime @db.Date
  source    String   @default("CBUAE")
  createdAt DateTime @default(now())

  @@unique([orgId, entityId, currency, rateDate])
  @@index([orgId, entityId, currency])
}

/// A journal that repeats — an accrual, a prepayment release, a standing charge.
///
/// The template is not the entries. Each run posts a real, independent journal
/// that stands on its own after the template is changed or deleted, because a
/// posting whose meaning depends on a mutable template is a posting nobody can
/// audit.
model RecurringJournal {
  id            String    @id @default(cuid())
  orgId         String
  entityId      String
  code          String
  name          String
  /// MONTHLY | QUARTERLY | ANNUAL
  frequency     String    @default("MONTHLY")
  startsOn      DateTime  @db.Date
  endsOn        DateTime? @db.Date
  /// How many times it has run, and the last period it ran for (YYYY-MM).
  runCount      Int       @default(0)
  lastRunPeriod String?
  /// The template lines, as JSON: [{account, debit|credit, memo}].
  lines         String
  /// ACCRUAL | PREPAYMENT | STANDING — shapes how the reversal behaves.
  kind          String    @default("STANDING")
  /// An accrual reverses on the first day of the next period; a standing
  /// charge does not.
  autoReverse   Boolean   @default(false)
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// An employee expense claim, from submission through to reimbursement.
model ExpenseClaim {
  id             String             @id @default(cuid())
  orgId          String
  entityId       String
  reference      String
  employeeCode   String
  employeeName   String
  claimedOn      DateTime           @db.Date
  currency       String             @default("AED")
  /// draft | submitted | approved | rejected | posted | paid
  status         String             @default("draft")
  submittedAt    DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedReason String?
  entryId        String?
  paidEntryId    String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lines          ExpenseClaimLine[]

  @@unique([orgId, entityId, reference])
  @@index([orgId, entityId, status])
}

model ExpenseClaimLine {
  id             String       @id @default(cuid())
  orgId          String
  claimId        String
  claim          ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  spentOn        DateTime     @db.Date
  description    String
  accountCode    String
  netMinor       BigInt
  vatMinor       BigInt       @default(0)
  /// Input VAT is only recoverable against a valid tax invoice showing a TRN.
  supplierTrn    String?
  vatRecoverable Boolean      @default(false)
  receiptRef     String?

  @@index([claimId])
}

/// A file attached to something in the books — a receipt, a contract, a bank
/// statement. Content is stored by hash so the same PDF attached twice costs
/// one copy, and so an attachment can be proved unaltered.
model Attachment {
  id          String   @id @default(cuid())
  orgId       String
  entityId    String?
  /// What it is attached to: JOURNAL_ENTRY | INVOICE | BILL | EXPENSE_CLAIM | ASSET | BANK_LINE
  subjectType String
  subjectId   String
  filename    String
  mimeType    String
  sizeBytes   Int
  /// SHA-256 of the content. Two identical files share one blob.
  sha256      String
  /// The bytes, base64. Small documents only — see the size guard.
  content     String
  uploadedBy  String?
  uploadedAt  DateTime @default(now())

  @@index([orgId, subjectType, subjectId])
  @@index([orgId, sha256])
}

/// An approval rule: what needs approving, by whom, above what amount.
model ApprovalRule {
  id                String   @id @default(cuid())
  orgId             String
  entityId          String
  /// JOURNAL | BILL | EXPENSE_CLAIM | PAYMENT | PAYROLL
  subjectType       String
  /// Applies above this amount; a rule at zero applies to everything.
  thresholdMinor    BigInt   @default(0)
  /// How many distinct people must approve.
  approversRequired Int      @default(1)
  /// Role that may approve, or a specific user id.
  approverRole      String?
  approverUserId    String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orgId, entityId, subjectType, active])
}

/// One approval decision. Append-only: a change of mind is another row.
model ApprovalDecision {
  id          String   @id @default(cuid())
  orgId       String
  entityId    String
  subjectType String
  subjectId   String
  /// APPROVED | REJECTED
  decision    String
  decidedBy   String
  decidedAt   DateTime @default(now())
  amountMinor BigInt?
  reason      String?
  /// The role codes this person held at the moment they decided, comma-separated.
  /// Recorded here rather than read back later for the same reason the amount is:
  /// an approval is a statement about a moment, and reading the assignments today
  /// would un-approve a posted document when somebody changes job. NULL means the
  /// decision predates the column — unverified, not failed.
  decidedByRoles String?

  @@unique([orgId, subjectType, subjectId, decidedBy])
  @@index([orgId, entityId, subjectType, subjectId])
}

/// A group of entities reported together.
model ConsolidationGroup {
  id        String                @id @default(cuid())
  orgId     String
  code      String
  name      String
  /// The currency the group reports in.
  currency  String                @default("AED")
  members   ConsolidationMember[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([orgId, code])
}

model ConsolidationMember {
  id           String             @id @default(cuid())
  orgId        String
  groupId      String
  group        ConsolidationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entityId     String
  /// Percentage owned, in basis points: 10000 is wholly owned.
  ownershipBps Int                @default(10000)
  /// Entities inside the group, so intercompany balances can be eliminated.
  isParent     Boolean            @default(false)

  @@unique([groupId, entityId])
  @@index([orgId, groupId])
}

/// A commitment to buy. Not an accounting entry — an order changes nothing in
/// the books until goods arrive or an invoice does, which is exactly why
/// three-way matching has something to compare.
model PurchaseOrder {
  id           String              @id @default(cuid())
  orgId        String
  entityId     String
  number       String
  supplierName String
  supplierTrn  String?
  orderedOn    DateTime            @db.Date
  expectedOn   DateTime?           @db.Date
  currency     String              @default("AED")
  /// draft | open | part_received | received | closed | cancelled
  status       String              @default("draft")
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]

  @@unique([orgId, entityId, number])
  @@index([orgId, entityId, status])
}

model PurchaseOrderLine {
  id             String        @id @default(cuid())
  orgId          String
  orderId        String
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo         Int
  description    String
  sku            String?
  /// Thousandths, as inventory quantities are.
  quantityMilli  BigInt
  unitPriceMinor BigInt
  accountCode    String?
  /// Running totals, so a line can answer "what is still outstanding" alone.
  receivedMilli  BigInt        @default(0)
  invoicedMilli  BigInt        @default(0)

  @@unique([orderId, lineNo])
  @@index([orgId, orderId])
}

/// Goods physically arriving. Creates the accrual between receipt and invoice.
model GoodsReceipt {
  id         String             @id @default(cuid())
  orgId      String
  entityId   String
  orderId    String
  order      PurchaseOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  number     String
  receivedOn DateTime           @db.Date
  entryId    String?
  notes      String?
  createdAt  DateTime           @default(now())
  lines      GoodsReceiptLine[]

  @@unique([orgId, entityId, number])
  @@index([orgId, orderId])
}

model GoodsReceiptLine {
  id            String       @id @default(cuid())
  orgId         String
  receiptId     String
  receipt       GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId   String
  quantityMilli BigInt
  valueMinor    BigInt

  @@index([receiptId])
}

/// A job or project that costs and revenue are attributed to.
model Project {
  id           String    @id @default(cuid())
  orgId        String
  entityId     String
  code         String
  name         String
  customerName String?
  startsOn     DateTime  @db.Date
  endsOn       DateTime? @db.Date
  /// What was quoted, so actual can be measured against something.
  budgetMinor  BigInt    @default(0)
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// Why a project's budget is what it is.
///
/// `Project.budgetMinor` is one column, so revising it overwrote the figure
/// actual was being measured against and left nothing behind. A budget whose
/// history is invisible is a budget nobody can be held to: the overspend
/// disappears the moment somebody raises the number, and who raised it is not
/// recorded either.
///
/// Written inside the same transaction as the change, so a revision that is
/// visible is a revision that happened.
model ProjectBudgetRevision {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String
  /// What it was, and what it became. Both, so the row reads on its own
  /// without having to be chained to the one before it.
  priorMinor  BigInt
  budgetMinor BigInt
  /// Why. A revision nobody has to justify is the thing this table exists to
  /// prevent, so the column is required and the database checks it is not
  /// whitespace.
  reason      String
  revisedBy   String?
  revisedAt   DateTime @default(now())

  @@index([orgId, projectId, revisedAt])
}

/// A lease under IFRS 16 — a right-of-use asset and a lease liability.
model Lease {
  id                    String   @id @default(cuid())
  orgId                 String
  entityId              String
  code                  String
  name                  String
  lessor                String?
  startsOn              DateTime @db.Date
  endsOn                DateTime @db.Date
  /// Payment per period, in minor units.
  paymentMinor          BigInt
  /// MONTHLY | QUARTERLY | ANNUAL
  frequency             String   @default("MONTHLY")
  /// Incremental borrowing rate, annual, in basis points.
  discountRateBps       Int
  /// Computed at inception and then fixed — remeasurement is a separate event.
  initialLiabilityMinor BigInt   @default(0)
  initialRouMinor       BigInt   @default(0)
  liabilityMinor        BigInt   @default(0)
  accumRouDepMinor      BigInt   @default(0)
  /// YYYY-MM of the last period charged.
  chargedTo             String?
  status                String   @default("draft")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// A customer or supplier the books deal with.
///
/// Kept as its own record rather than a name repeated on every document,
/// because credit limits, payment terms and a TRN are facts about the party,
/// not about any one invoice.
model Counterparty {
  id               String   @id @default(cuid())
  orgId            String
  entityId         String
  code             String
  name             String
  nameAr           String?
  /// CUSTOMER | SUPPLIER | BOTH
  kind             String   @default("CUSTOMER")
  trn              String?
  email            String?
  phone            String?
  /// Days from invoice date. 0 means due on receipt.
  paymentTerms     Int      @default(30)
  /// Nil means no limit set, which is different from a limit of nothing.
  creditLimitMinor BigInt?
  /// Whether new sales are blocked because of overdue debt.
  onHold           Boolean  @default(false)
  holdReason       String?
  currency         String   @default("AED")
  notes            String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, kind, status])
}

/// A batch of supplier payments prepared, approved and released together.
model PaymentRun {
  id          String           @id @default(cuid())
  orgId       String
  entityId    String
  reference   String
  runDate     DateTime         @db.Date
  bankAccount String           @default("1010")
  currency    String           @default("AED")
  /// draft | approved | released | cancelled
  status      String           @default("draft")
  /// Who proposed the run. Recorded rather than passed in at approval time,
  /// because a separation-of-duties control that depends on the approver
  /// truthfully naming the preparer is not a control.
  preparedBy  String?
  approvedBy  String?
  approvedAt  DateTime?
  releasedAt  DateTime?
  entryId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       PaymentRunItem[]

  @@unique([orgId, entityId, reference])
  @@index([orgId, entityId, status])
}

model PaymentRunItem {
  id            String     @id @default(cuid())
  orgId         String
  runId         String
  run           PaymentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The bill being paid, and who it is owed to.
  billId        String?
  billNumber    String
  supplierName  String
  amountMinor   BigInt
  /// Excluded from the run, with the reason, rather than silently dropped.
  excluded      Boolean    @default(false)
  excludeReason String?

  @@index([runId])
}

/// A revenue contract under IFRS 15, with its performance obligations.
model RevenueContract {
  id             String                  @id @default(cuid())
  orgId          String
  entityId       String
  code           String
  customerName   String
  signedOn       DateTime                @db.Date
  /// The total transaction price allocated across obligations.
  priceMinor     BigInt
  /// What invoices have charged against this contract, cumulative and net of
  /// tax. The difference between this and what has been earned is the contract
  /// asset or contract liability IFRS 15 requires to be presented.
  billedMinor    BigInt                  @default(0)
  /// Where this contract's revenue lands in the chart.
  revenueAccount String                  @default("4100")
  currency       String                  @default("AED")
  status         String                  @default("active")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  obligations    PerformanceObligation[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

model PerformanceObligation {
  id                   String          @id @default(cuid())
  orgId                String
  contractId           String
  contract             RevenueContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  seq                  Int
  description          String
  /// The standalone selling price, used to allocate the transaction price.
  standalonePriceMinor BigInt
  /// What the allocation gave this obligation.
  allocatedMinor       BigInt          @default(0)
  /// POINT_IN_TIME | OVER_TIME
  timing               String          @default("POINT_IN_TIME")
  /// Recognised so far, in minor units.
  recognisedMinor      BigInt          @default(0)
  /// Percent complete in basis points, for an over-time obligation.
  progressBps          Int             @default(0)
  satisfiedOn          DateTime?       @db.Date

  @@unique([contractId, seq])
  @@index([orgId, contractId])
}

/// A quotation or sales order: what we have offered or agreed to sell, before
/// any of it is invoiced. Nothing here touches the ledger — a promise is not a
/// transaction — but the running invoiced quantity lets a line answer "what is
/// still to be delivered" without scanning the invoices.
model SalesOrder {
  id           String           @id @default(cuid())
  orgId        String
  entityId     String
  number       String
  /// QUOTE | ORDER — a quote can expire, an order cannot.
  kind         String           @default("QUOTE")
  customerCode String?
  customerName String
  customerTrn  String?
  issuedOn     DateTime         @db.Date
  /// A quote that nobody accepted stops being an offer on this date.
  validUntil   DateTime?        @db.Date
  currency     String           @default("AED")
  /// draft | sent | accepted | part_invoiced | invoiced | declined | expired | cancelled
  status       String           @default("draft")
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lines        SalesOrderLine[]

  @@unique([orgId, entityId, number])
  @@index([orgId, entityId, status])
}

model SalesOrderLine {
  id             String     @id @default(cuid())
  orgId          String
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo         Int
  description    String
  sku            String?
  /// Thousandths, as inventory quantities are.
  quantityMilli  BigInt
  unitPriceMinor BigInt
  /// Basis points off the line, so 1000 is ten percent.
  discountBps    Int        @default(0)
  /// A TaxProfileCode, in the product's own spelling. "SR" is what a UAE
  /// bookkeeper writes and the module accepts it, but it is stored canonically
  /// so that one treatment cannot become two categories on the VAT return.
  taxCode        String     @default("STANDARD_5")
  accountCode    String?
  /// How much of the line has been turned into an invoice.
  invoicedMilli  BigInt     @default(0)

  @@unique([orderId, lineNo])
  @@index([orgId, orderId])
}

/// An imprest float: a fixed sum of cash held by someone, topped back up to
/// that sum when it is reimbursed. The float amount is the point — the cash on
/// hand plus the unreimbursed receipts must always equal it.
model PettyCashFund {
  id          String              @id @default(cuid())
  orgId       String
  entityId    String
  code        String
  name        String
  custodian   String
  /// The imprest amount the float is restored to.
  floatMinor  BigInt
  /// The ledger account the cash sits in. 1000 is "Cash on hand" — a tin of
  /// notes is not a bank account, and coding it to one makes the bank
  /// reconciliation ask for a statement that will never exist.
  accountCode String              @default("1000")
  currency    String              @default("AED")
  status      String              @default("active")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  movements   PettyCashMovement[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

model PettyCashMovement {
  id          String        @id @default(cuid())
  orgId       String
  fundId      String
  fund        PettyCashFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  seq         Int
  /// OPENING | SPEND | REIMBURSE | RETURN — the four things that move a float.
  kind        String
  movedOn     DateTime      @db.Date
  description String
  /// Always positive; the kind says which way the cash went.
  amountMinor BigInt
  /// Where a spend was coded to.
  accountCode String?
  vatMinor    BigInt        @default(0)
  supplierTrn String?
  receiptRef  String?
  /// The journal entry this movement posted, once it is on the ledger.
  entryId     String?

  @@unique([fundId, seq])
  @@index([orgId, fundId])
}

/// A saved report layout: rows the user defined over account ranges, so a
/// business can present its numbers the way it reads them without anyone
/// editing code. The definition is data, so it can be copied between entities.
model ReportLayout {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  code      String
  name      String
  /// BALANCE | PROFIT — which side of the books the rows draw from.
  basis     String   @default("PROFIT")
  /// Rows: [{ label, kind: 'accounts'|'total'|'spacer'|'heading', from?, to?, of?, invert? }]
  rows      Json
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// A temporary difference between what an item is worth in the accounts and
/// what it is worth for tax (IAS 12.5). The register is kept per reporting
/// date rather than as a running balance, because the deferred tax charge for
/// a period is the movement between two dates and a running balance cannot be
/// reconstructed once it has been overwritten.
model DeferredTaxItem {
  id                String   @id @default(cuid())
  orgId             String
  entityId          String
  /// The reporting date these figures were measured at.
  asOf              DateTime @db.Date
  code              String
  description       String
  /// FIXED_ASSET | PROVISION | LEASE | LOSS | REVENUE | OTHER
  category          String   @default("OTHER")
  /// What the accounts carry it at.
  carryingMinor     BigInt
  /// What tax law will allow or charge in future — the tax base (IAS 12.7-8).
  taxBaseMinor      BigInt
  /// The rate expected to apply when the difference reverses (IAS 12.47), in
  /// basis points. 900 is the UAE's 9% headline rate.
  rateBps           Int      @default(900)
  /// A deductible difference is only an asset to the extent future profit is
  /// probable (IAS 12.24). Nil means recognised in full.
  unrecognisedMinor BigInt   @default(0)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([orgId, entityId, asOf, code])
  @@index([orgId, entityId, asOf])
}

/// The deferred tax position posted at one reporting date, so the next period
/// knows what the movement is measured against.
model DeferredTaxPosting {
  id             String   @id @default(cuid())
  orgId          String
  entityId       String
  asOf           DateTime @db.Date
  /// Net position: positive is a liability, negative an asset.
  netMinor       BigInt
  assetMinor     BigInt
  liabilityMinor BigInt
  /// The movement charged to profit or loss for the period.
  chargeMinor    BigInt
  entryId        String?
  createdAt      DateTime @default(now())

  @@unique([orgId, entityId, asOf])
  @@index([orgId, entityId])
}

/// A provision (IAS 37): a liability of uncertain timing or amount. The
/// register is separate from the ledger because the standard's disclosures ask
/// for the movement in each class — opened, used, released, unwound — and a
/// balance alone cannot answer that.
model Provision {
  id              String              @id @default(cuid())
  orgId           String
  entityId        String
  code            String
  name            String
  /// LEGAL | WARRANTY | RESTRUCTURING | ONEROUS | DECOMMISSIONING | OTHER
  category        String              @default("OTHER")
  /// PROVISION | CONTINGENT_LIABILITY | CONTINGENT_ASSET — a contingency is
  /// disclosed, never recognised (IAS 37.27/31), which is the distinction the
  /// whole standard turns on.
  kind            String              @default("PROVISION")
  recognisedOn    DateTime            @db.Date
  /// The best estimate of the outflow required to settle (IAS 37.36).
  estimateMinor   BigInt
  /// Where the time value of money is material the estimate is discounted
  /// (IAS 37.45) and the discount unwinds as a finance cost.
  discountRateBps Int                 @default(0)
  expectedOn      DateTime?           @db.Date
  /// What the balance sheet carries now — nil for a contingency.
  carryingMinor   BigInt              @default(0)
  accountCode     String              @default("2150")
  expenseAccount  String              @default("6900")
  /// open | settled | released
  status          String              @default("open")
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  movements       ProvisionMovement[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

model ProvisionMovement {
  id          String    @id @default(cuid())
  orgId       String
  provisionId String
  provision   Provision @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  seq         Int
  /// RECOGNISE | REMEASURE | UNWIND | UTILISE | RELEASE
  kind        String
  movedOn     DateTime  @db.Date
  /// Signed: what the movement did to the carrying amount.
  amountMinor BigInt
  note        String?
  entryId     String?

  @@unique([provisionId, seq])
  @@index([orgId, provisionId])
}

/// A set of permissions someone can be given. Roles are per organisation and
/// can be scoped to one entity, because a bookkeeper for the Dubai company is
/// not thereby a bookkeeper for the Abu Dhabi one.
model AccountingRole {
  id          String           @id @default(cuid())
  orgId       String
  code        String
  name        String
  description String?
  /// The permission keys this role grants, as a JSON array of strings.
  permissions Json
  /// A role the product ships. It can be assigned but not edited or deleted,
  /// so a workspace cannot quietly redefine what "Approver" means.
  builtIn     Boolean          @default(false)
  status      String           @default("active")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments RoleAssignment[]

  @@unique([orgId, code])
  @@index([orgId, status])
}

model RoleAssignment {
  id        String         @id @default(cuid())
  orgId     String
  userId    String
  roleId    String
  role      AccountingRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// The entity this grant applies to, or "*" for every entity in the org.
  /// A literal rather than null, so the uniqueness below actually holds —
  /// Postgres treats two NULLs as distinct and would allow the same grant
  /// twice.
  entityId  String         @default("*")
  grantedBy String?
  grantedAt DateTime       @default(now())

  @@unique([orgId, userId, roleId, entityId])
  @@index([orgId, userId])
}

/// A FIFO cost layer: one receipt, at the cost it came in at, with what is
/// left of it. Weighted average needs no layers — it carries one cost — but
/// first-in-first-out cannot be reconstructed from a running average, so the
/// layers are the record rather than a cache of one.
model InventoryLayer {
  id             String        @id @default(cuid())
  orgId          String
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seq            Int
  receivedOn     DateTime      @db.Date
  /// Thousandths, as inventory quantities are.
  quantityMilli  BigInt
  /// What is left of this layer. Nil means it is fully consumed.
  remainingMilli BigInt
  /// Cost per whole unit, in minor units.
  unitCostMinor  BigInt
  /// The receipt that created it.
  movementId     String?

  @@unique([itemId, seq])
  @@index([orgId, itemId, receivedOn])
}

/// A revaluation or impairment of a fixed asset, kept per event rather than as
/// a running figure. IAS 16.39-40 splits an increase or decrease between profit
/// and the revaluation surplus according to what has happened to that asset
/// before — so the history is the rule's input, not a record of it.
model AssetRevaluation {
  id                  String     @id @default(cuid())
  orgId               String
  entityId            String
  assetId             String
  asset               FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  seq                 Int
  revaluedOn          DateTime   @db.Date
  /// REVALUATION (upward), IMPAIRMENT (downward), or REVERSAL of an impairment.
  kind                String
  /// The carrying amount immediately before this event.
  carryingBeforeMinor BigInt
  /// What it was assessed to be worth.
  fairValueMinor      BigInt
  /// Signed: positive is an increase in carrying amount.
  movementMinor       BigInt
  /// How the movement was split. The two always add to it.
  toSurplusMinor      BigInt     @default(0)
  toProfitMinor       BigInt     @default(0)
  /// The revaluation surplus this asset carries after the event.
  surplusAfterMinor   BigInt     @default(0)
  /// Months of useful life left when the event happened. Recorded because the
  /// IAS 36.117 ceiling is a counterfactual — what the asset would be carried
  /// at had nothing been impaired — and that path depreciates over the life
  /// that remained then, which the register no longer holds afterwards.
  lifeRemainingMonths Int        @default(0)
  basis               String?
  entryId             String?
  createdAt           DateTime   @default(now())

  @@unique([assetId, seq])
  @@index([orgId, entityId, revaluedOn])
}

/// A cheque, held rather than banked.
///
/// Post-dated cheques are how a great deal of UAE business is actually
/// settled, and a cheque in the drawer is not cash and not quite a receivable
/// either — it is a receivable whose form has changed. The register carries it
/// from the day it is taken to the day it clears or bounces, because those are
/// different events with different journals and a system that models only the
/// last one cannot answer where the money is today.
model Cheque {
  id             String    @id @default(cuid())
  orgId          String
  entityId       String
  /// RECEIVED from a customer, or ISSUED to a supplier.
  direction      String
  number         String
  bankName       String?
  /// The account it will be drawn on or paid into, once it moves.
  bankAccount    String    @default("1010")
  /// Who wrote it, or who it is written to.
  counterparty   String
  counterpartyId String?
  writtenOn      DateTime  @db.Date
  /// The day it may be presented. That is what makes it post-dated.
  dueOn          DateTime  @db.Date
  amountMinor    BigInt
  currency       String    @default("AED")
  /// held | deposited | cleared | bounced | returned | cancelled
  status         String    @default("held")
  /// The open item it settles, once it clears.
  settlesId      String?
  /// Each state change that reached the ledger.
  heldEntryId    String?
  clearedEntryId String?
  bouncedEntryId String?
  statusOn       DateTime? @db.Date
  bounceReason   String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([orgId, entityId, direction, number])
  @@index([orgId, entityId, status, dueOn])
}

/// Somewhere stock is kept. A business with one store still has one location;
/// the difference is whether the software can say which.
model StockLocation {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  code      String
  name      String
  nameAr    String?
  /// Where goods land by default when nobody says.
  isDefault Boolean  @default(false)
  address   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// A batch or a serial number, with the expiry that makes it perishable.
/// Quantity is carried per batch as well as per item, because "how much do we
/// have" and "how much of it can still be sold" are different questions.
model StockBatch {
  id            String        @id @default(cuid())
  orgId         String
  entityId      String
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId    String?
  /// The batch code, or the serial number where each unit is tracked singly.
  code          String
  /// SERIAL means exactly one unit and cannot be split.
  kind          String        @default("BATCH")
  receivedOn    DateTime      @db.Date
  expiresOn     DateTime?     @db.Date
  quantityMilli BigInt        @default(0)
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([orgId, entityId, itemId, code])
  @@index([orgId, entityId, expiresOn])
}

/// An asset within the VAT capital assets scheme: input tax recovered when it
/// was bought is adjusted over ten years for a building or five for anything
/// else, as the proportion of taxable use changes.
model CapitalAssetItem {
  id             String                   @id @default(cuid())
  orgId          String
  entityId       String
  code           String
  description    String
  /// BUILDING (ten intervals) | OTHER (five).
  category       String                   @default("OTHER")
  acquiredOn     DateTime                 @db.Date
  /// The day the asset was first used, which starts the adjustment period.
  firstUsedOn    DateTime                 @db.Date
  costMinor      BigInt
  /// Input tax on the purchase, in full.
  inputTaxMinor  BigInt
  /// The taxable-use proportion claimed at the outset, in basis points.
  originalUseBps Int
  status         String                   @default("active")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  adjustments    CapitalAssetAdjustment[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

model CapitalAssetAdjustment {
  id              String           @id @default(cuid())
  orgId           String
  assetId         String
  asset           CapitalAssetItem @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// 1 for the first interval after the year of purchase, and so on.
  interval        Int
  assessedOn      DateTime         @db.Date
  /// Taxable use in this interval, in basis points.
  useBps          Int
  /// Positive is more input tax recoverable; negative is tax to repay.
  adjustmentMinor BigInt
  entryId         String?
  createdAt       DateTime         @default(now())

  @@unique([assetId, interval])
  @@index([orgId, assetId])
}


/// A subscription: an invoice that recurs on its own schedule.
///
/// The lines are held as data rather than as a document, because a template is
/// not an invoice — it is the instruction for making one, and every invoice it
/// makes is a separate document with its own number, its own date and its own
/// life. `RecurringJournal` does the same thing for journals; this is its
/// counterpart on the sales side, and the two are deliberately separate
/// because a journal template posts and an invoice template raises a document
/// that somebody sends.
model RecurringInvoice {
  id            String   @id @default(cuid())
  orgId         String
  entityId      String
  code          String
  customerCode  String?
  customerName  String
  customerTrn   String?
  /// WEEKLY | MONTHLY | QUARTERLY | ANNUAL
  frequency     String   @default("MONTHLY")
  startsOn      DateTime @db.Date
  endsOn        DateTime? @db.Date
  /// The next date an invoice is due to be raised.
  nextOn        DateTime @db.Date
  /// Days from the invoice date to the due date.
  paymentTerms  Int      @default(30)
  currency      String   @default("AED")
  /// [{ description, quantityMilli, unitPriceMinor, taxCode, accountCode? }]
  lines         Json
  notes         String?
  /// active | paused | ended
  status        String   @default("active")
  lastIssuedOn  DateTime? @db.Date
  issuedCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  issued        RecurringInvoiceIssue[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status, nextOn])
}

/// One invoice a subscription raised, so a template can say what it has done
/// and a retry cannot raise the same period twice.
model RecurringInvoiceIssue {
  id          String           @id @default(cuid())
  orgId       String
  templateId  String
  template    RecurringInvoice @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// The period this invoice was for, as YYYY-MM-DD of its scheduled date.
  scheduledOn DateTime         @db.Date
  issuedOn    DateTime         @db.Date
  invoiceId   String
  invoiceNumber String
  totalMinor  BigInt
  createdAt   DateTime         @default(now())

  @@unique([templateId, scheduledOn])
  @@index([orgId, templateId])
}


/// Time worked, which for a service business is the raw material.
///
/// Recorded in minutes rather than decimal hours, because a quarter of an hour
/// is 15 and 0.25 of an hour is a float that will not add up over a month.
model TimeEntry {
  id           String   @id @default(cuid())
  orgId        String
  entityId     String
  projectCode  String?
  employeeCode String
  workedOn     DateTime @db.Date
  minutes      Int
  /// Charge-out rate per hour, in minor units.
  rateMinor    BigInt
  /// Cost per hour, where it is known. Nil means nobody has set one, which is
  /// different from work that costs nothing.
  costRateMinor BigInt?
  description  String
  /// Work that will be charged for. Non-billable time is still recorded,
  /// because what it cost is real whether or not anybody pays for it.
  billable     Boolean  @default(true)
  /// draft | approved | invoiced | written_off
  status       String   @default("draft")
  invoiceId    String?
  writeOffReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId, entityId, projectCode, workedOn])
  @@index([orgId, entityId, employeeCode, workedOn])
}

/// The work-in-progress balance recognised at a period end, kept per period
/// because the charge for a month is the movement between two dates.
model WipPosting {
  id           String   @id @default(cuid())
  orgId        String
  entityId     String
  period       String
  balanceMinor BigInt
  chargeMinor  BigInt
  minutes      Int
  entryId      String?
  createdAt    DateTime @default(now())

  @@unique([orgId, entityId, period])
  @@index([orgId, entityId])
}


/// A price list: what an item is sold or bought at, for whom, from when.
///
/// Prices are otherwise typed onto every document by hand, which is where
/// margin quietly leaks — nobody can report on a discount that was never
/// recorded as one.
model PriceList {
  id        String    @id @default(cuid())
  orgId     String
  entityId  String
  code      String
  name      String
  /// A list prices in one currency. A list in another currency is not
  /// converted into the document's — see the module for why.
  currency  String    @default("AED")
  /// SELL | BUY
  kind      String    @default("SELL")
  /// The list used when a party has no list of its own.
  isDefault Boolean   @default(false)
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, kind, isDefault])
}

/// One priced row: an item, at a quantity break, over a period.
model PriceListEntry {
  id              String    @id @default(cuid())
  orgId           String
  priceListId     String
  itemCode        String
  /// The quantity from which this row applies, in thousandths. Nought is the
  /// base price.
  minQuantityMilli BigInt   @default(0)
  unitPriceMinor  BigInt
  /// A discount carried by the list itself, so a "10% off list" arrangement
  /// is a fact about the arrangement rather than arithmetic somebody did.
  discountBps     Int       @default(0)
  validFrom       DateTime  @db.Date
  validTo         DateTime? @db.Date
  createdAt       DateTime  @default(now())

  @@index([orgId, priceListId, itemCode, minQuantityMilli])
}

/// Which list prices for which party. A party with no assignment is priced
/// from the default list.
model PriceListAssignment {
  id          String   @id @default(cuid())
  orgId       String
  entityId    String
  /// The customer or supplier, by the key counterparties.ts resolves to.
  partyKey    String
  priceListId String
  createdAt   DateTime @default(now())

  @@unique([orgId, entityId, partyKey, priceListId])
  @@index([orgId, entityId, partyKey])
}

/// A credit limit as it was assessed on a date.
///
/// `Counterparty.creditLimitMinor` holds one figure and no history, which
/// cannot answer the question an auditor actually asks: what was this customer
/// allowed to owe on the day that order was taken? A limit raised in March
/// does not retrospectively make February's breach acceptable, and a limit cut
/// today does not make last quarter's sales a breach. So the assessments are
/// kept as rows and the limit in force on a date is the latest row on or
/// before it.
///
/// A row with `limitMinor` of nought is a real assessment — cash up front. The
/// *absence* of any row is the different state: nobody has assessed this
/// account at all.
model CreditLimit {
  id            String   @id @default(cuid())
  orgId         String
  entityId      String
  /// The counterparty's own code, which is what credit control joins on.
  partyKey      String
  /// Minor units of the entity's functional currency — the currency the
  /// receivables control account is kept in, so a limit and an exposure can be
  /// compared without a rate.
  limitMinor    BigInt
  effectiveFrom DateTime @db.Date
  /// Why this figure. A limit nobody can defend is a limit nobody enforces.
  basis         String
  setBy         String?
  createdAt     DateTime @default(now())

  @@unique([orgId, entityId, partyKey, effectiveFrom])
  @@index([orgId, entityId, partyKey, effectiveFrom])
}

/// One credit hold, placed and later released.
///
/// The release is a second set of columns on the same row rather than a delete,
/// because the history is the point: whoever is asked to release the next hold
/// needs to see that this customer has been held twice before and why it was
/// lifted each time. A deleted hold answers none of that.
model CreditHold {
  id            String    @id @default(cuid())
  orgId         String
  entityId      String
  partyKey      String
  placedOn      DateTime  @db.Date
  placedBy      String?
  reason        String
  releasedOn    DateTime? @db.Date
  releasedBy    String?
  releaseReason String?
  createdAt     DateTime  @default(now())

  @@index([orgId, entityId, partyKey, placedOn])
}

/// A dunning letter that was produced, and where it went.
///
/// Without this row the ladder has no memory: every run computes the same stage
/// from the same ageing and the customer receives the same first reminder every
/// morning, which teaches them that the letters mean nothing. The row is what
/// makes "already chased three days ago" and "already had the second letter"
/// answerable.
model DunningNotice {
  id           String   @id @default(cuid())
  orgId        String
  entityId     String
  partyKey     String
  /// reminder | first | second | final
  stage        String
  sentOn       DateTime @db.Date
  /// Where it went. "We chased them" with no address is not evidence.
  sentTo       String
  /// The position the letter was written from, so it can be read back against
  /// what was owed that day rather than against what is owed now.
  overdueMinor BigInt
  oldestDays   Int
  itemCount    Int
  /// The text itself. It is what the customer holds, so a dispute is settled by
  /// reading it rather than by reconstructing what it probably said.
  letter       String
  recordedBy   String?
  createdAt    DateTime @default(now())

  @@index([orgId, entityId, partyKey, sentOn])
}


/// A delivery note: what physically left, and when.
///
/// It is a document, not a journal. Dispatching stock moves cost out of
/// inventory; the revenue is on the invoice, and the two are deliberately not
/// the same event.
model DeliveryNote {
  id           String             @id @default(cuid())
  orgId        String
  entityId     String
  number       String
  /// The order it fulfils, where there is one. Goods can leave without an
  /// order — a replacement, a sample — and refusing that would only push the
  /// movement somewhere the register cannot see it.
  orderId      String?
  customerName String
  deliveredOn  DateTime           @db.Date
  /// draft | dispatched | delivered | cancelled
  status       String             @default("draft")
  carrier      String?
  trackingRef  String?
  /// Who signed for the goods, and when. A delivery nobody signed for is
  /// still a delivery; it is just harder to argue about.
  signedBy     String?
  signedOn     DateTime?          @db.Date
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        DeliveryNoteLine[]

  @@unique([orgId, entityId, number])
  @@index([orgId, entityId, deliveredOn])
  @@index([orgId, orderId])
}

model DeliveryNoteLine {
  id            String       @id @default(cuid())
  orgId         String
  noteId        String
  note          DeliveryNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  lineNo        Int
  /// The order line this fulfils, where the note fulfils an order.
  orderLineId   String?
  sku           String?
  description   String
  /// Thousandths, as every inventory quantity is.
  quantityMilli BigInt
  /// What the stock movement cost, once dispatched. Nil until then, and nil
  /// for a line carrying no SKU — a service on a delivery note has no cost of
  /// its own to move.
  costMinor     BigInt?
  movementId    String?

  @@unique([noteId, lineNo])
  @@index([orgId, noteId])
  @@index([orgId, orderLineId])
}


/// Why a number series changed format, and from which number. A prefix may be
/// changed part way through a year; a prefix change nobody recorded may not,
/// because an auditor tracing a reference then has no way to find out why the
/// format moved. The counter itself is never in here: it is not editable.
model DocumentSequenceChange {
  id                String   @id @default(cuid())
  orgId             String
  entityId          String
  scope             String
  changedAt         DateTime @default(now())
  /// The next number the series would issue at the moment of the change, so
  /// everything from this number on carries the new format.
  effectiveFromNo   Int
  fromPrefix        String
  toPrefix          String
  fromPadding       Int
  toPadding         Int
  fromRestartYearly Boolean  @default(false)
  toRestartYearly   Boolean  @default(false)
  note              String?
  actorId           String?

  @@index([orgId, entityId, scope, changedAt])
}

/// A loan or other borrowing, measured at amortised cost under IFRS 9.
///
/// The facility's terms are a contract and the ledger records only their
/// consequences, so the register and the books are two records on purpose —
/// `borrowingRegister()` puts them side by side and reports the difference
/// rather than reconciling it away.
///
/// The instalment and the effective rate are computed at drawdown and then
/// FIXED. Everything else about the schedule follows from the terms, so it is
/// derived rather than stored; but those two are what the postings were made
/// from, and recomputing them later would let an edit to the register silently
/// restate a period that has already been closed.
model Borrowing {
  id                  String   @id @default(cuid())
  orgId               String
  entityId            String
  code                String
  lender              String
  /// Recorded, but a drawdown in anything but the book's own currency is
  /// refused: IAS 21.23(a) retranslates a monetary liability at every reporting
  /// date and nothing here does that.
  currency            String   @default("AED")
  /// Face amount advanced, in minor units.
  principalMinor      BigInt
  drawdownOn          DateTime @db.Date
  /// The rate as the facility quotes it, annual, in basis points. 5% is 500.
  statedRateBps       Int
  /// REDUCING charges interest on the balance left; FLAT on the original sum.
  interestBasis       String   @default("REDUCING")
  /// MONTHLY | QUARTERLY | SEMIANNUAL | ANNUAL
  frequency           String   @default("MONTHLY")
  /// Whole months from the drawdown to the last instalment.
  termMonths          Int
  /// The level instalment, fixed at drawdown.
  instalmentMinor     BigInt   @default(0)
  /// The rate IFRS 9 measures at: the one that discounts the instalments back
  /// to what was advanced. For a flat facility it is far above the quoted rate.
  effectiveRateBps    Int      @default(0)
  /// Carrying amount — the principal still outstanding at amortised cost.
  outstandingMinor    BigInt   @default(0)
  /// How much of `outstandingMinor` has been reclassified to the current-portion
  /// account. Not the same as what IAS 1.69 says it should be today; the
  /// register reports both, and their differing means the split has not been run.
  currentPortionMinor BigInt   @default(0)
  /// The last instalment number posted. Nought means none.
  paidTo              Int      @default(0)
  status              String   @default("draft")
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  covenants           BorrowingCovenant[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, status])
}

/// A condition of the facility, and the threshold it has to stay the right side
/// of. Only metrics the ledger can actually compute are testable; anything else
/// is recorded with metric OTHER and reported as untested, never as a pass.
model BorrowingCovenant {
  id           String    @id @default(cuid())
  orgId        String
  borrowingId  String
  code         String
  /// CURRENT_RATIO | DEBT_TO_EQUITY | INTEREST_COVER | MIN_NET_WORTH | OTHER
  metric       String
  /// MIN sets a floor, MAX sets a ceiling.
  direction    String    @default("MIN")
  /// For a ratio: basis points. A current ratio of 1.25 is 12500. A ratio held
  /// as a decimal disagrees with itself at the fourth place.
  thresholdBps Int?
  /// For an amount: minor units.
  thresholdMinor BigInt?
  /// What the covenant says, in the lender's own words.
  wording      String?
  createdAt    DateTime  @default(now())
  borrowing    Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)

  @@unique([orgId, borrowingId, code])
  @@index([orgId, borrowingId])
}

/// A landed cost voucher: the freight, insurance, duty and handling invoices
/// for one shipment, and the goods receipts they are to be carried onto.
///
/// IAS 2.10 makes those charges part of what the goods cost. Expensing them
/// understates inventory and overstates cost of sales in the period the goods
/// arrive, then flatters the period they are sold in — an error that is largest
/// exactly when stock is largest, which is usually the year end.
model LandedCostVoucher {
  id          String                 @id @default(cuid())
  orgId       String
  entityId    String
  /// The voucher's own number.
  number      String
  /// The shipment, container or bill of lading the charges belong to. Several
  /// vouchers can name one shipment — the duty invoice rarely arrives with the
  /// freight invoice — and the report groups by it.
  shipmentRef String
  voucherDate DateTime               @db.Date
  /// draft | applied | cancelled
  status      String                 @default("draft")
  notes       String?
  /// When the charges were carried onto the goods, and the one entry that did it.
  appliedOn   DateTime?              @db.Date
  entryId     String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  charges     LandedCostCharge[]
  lines       LandedCostLine[]
  allocations LandedCostAllocation[]

  @@unique([orgId, entityId, number])
  @@index([orgId, entityId, status])
  @@index([orgId, entityId, shipmentRef])
}

/// One charge on the voucher — a freight invoice, a duty receipt — with the
/// account it is currently sitting in and the basis it is to be spread on.
///
/// The basis is per charge rather than per voucher because the right one
/// differs by charge: freight follows weight or volume, duty follows value.
/// One basis for a whole voucher would be wrong for at least one of them.
model LandedCostCharge {
  id          String                 @id @default(cuid())
  orgId       String
  voucherId   String
  voucher     LandedCostVoucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo      Int
  description String
  /// Minor units. Always positive — a charge that reduces what goods cost is a
  /// credit note against the supplier, not a landed cost.
  amountMinor BigInt
  /// The account the charge is sitting in now, and which this voucher credits.
  accountCode String
  /// VALUE | QUANTITY | WEIGHT | VOLUME
  basis       String                 @default("VALUE")
  allocations LandedCostAllocation[]

  @@unique([voucherId, lineNo])
  @@index([orgId, voucherId])
}

/// One lot of goods the voucher lands onto: an inventory receipt, named by the
/// goods received note it came in under.
model LandedCostLine {
  id             String                 @id @default(cuid())
  orgId          String
  voucherId      String
  voucher        LandedCostVoucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo         Int
  itemId         String
  sku            String
  /// The goods received note. The receipt movement it resolved to is held too,
  /// because the note is the human's name for it and the movement is the record.
  receiptRef     String
  movementId     String
  /// What came in, and what it cost before anything was landed on it.
  quantityMilli  BigInt
  valueMinor     BigInt
  /// The shipped weight and volume of this lot where they were actually
  /// weighed or measured, in the same thousandths as everything else: grams
  /// and litres. Nil falls back to the item's recorded figure per unit.
  weightMilli    BigInt?
  volumeMilli    BigInt?
  /// Filled in when the voucher is applied: what was still on the shelf then,
  /// what was carried onto it in total, and how that total split.
  onHandMilli    BigInt?
  allocatedMinor BigInt?
  inventoryMinor BigInt?
  cogsMinor      BigInt?
  allocations    LandedCostAllocation[]

  @@unique([voucherId, lineNo])
  @@index([orgId, voucherId])
  @@index([orgId, itemId])
}

/// What one charge put on one lot of goods. Kept per pair rather than netted
/// into a total, because "which charge landed this" is the question an auditor
/// asks and a total cannot answer it.
model LandedCostAllocation {
  id             String            @id @default(cuid())
  orgId          String
  voucherId      String
  voucher        LandedCostVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  chargeId       String
  charge         LandedCostCharge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  lineId         String
  line           LandedCostLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  /// The weight this share was worked out on — value, quantity, grams or
  /// litres, whichever the charge is spread by. Kept so the arithmetic can be
  /// checked years later against a measure that may since have changed.
  basisWeight    BigInt
  allocatedMinor BigInt
  /// Of that share, what went onto stock still held and what went to cost of
  /// sales because those units had already been sold. The two always add back
  /// to the share — the database checks it.
  inventoryMinor BigInt
  cogsMinor      BigInt

  @@unique([chargeId, lineId])
  @@index([orgId, voucherId])
}

/// What one unit of an item weighs and how much room it takes up.
///
/// Freight is charged by weight or by volume, so allocating it needs both, and
/// neither is a fact about a transaction — they are facts about the item, kept
/// once. Thousandths throughout: grams per whole unit, and litres per whole
/// unit. Nil means nobody has recorded one, which is why a weight-based
/// allocation refuses rather than treating the item as weightless.
model LandedCostMeasure {
  id              String   @id @default(cuid())
  orgId           String
  entityId        String
  itemId          String
  sku             String
  unitWeightMilli BigInt?
  unitVolumeMilli BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([orgId, entityId, itemId])
  @@index([orgId, entityId])
}


/// A party somebody has declared to be related, under IAS 24.
///
/// Declared, not detected. Relatedness is a fact about people and control —
/// a director's spouse, an entity under common control — and no chart of
/// accounts holds it. A detector would produce a confident, incomplete list
/// and a reader would take its silence as a statement.
model RelatedParty {
  id           String    @id @default(cuid())
  orgId        String
  entityId     String
  /// The counterparty, by the folded key counterparties resolve to.
  partyKey     String
  name         String
  /// PARENT | SUBSIDIARY | ASSOCIATE | JOINT_VENTURE | KEY_MANAGEMENT |
  /// CLOSE_FAMILY | COMMON_CONTROL | POST_EMPLOYMENT_PLAN | OTHER
  relationship String
  /// Who said so, and when. A declaration nobody owns is not a declaration.
  declaredBy   String
  declaredOn   DateTime  @db.Date
  startedOn    DateTime  @db.Date
  /// When the relationship ended. IAS 24 asks about the reporting period, so a
  /// relationship that ended mid-year is still disclosable for the part of the
  /// year it existed.
  endedOn      DateTime? @db.Date
  notes        String?
  createdAt    DateTime  @default(now())

  @@unique([orgId, entityId, partyKey, startedOn])
  @@index([orgId, entityId, relationship])
}

/// Compensation of key management personnel — IAS 24.17, which asks for the
/// total AND each of five categories. A total on its own does not comply.
model KeyManagementComp {
  id          String   @id @default(cuid())
  orgId       String
  entityId    String
  /// The reporting period this covers, as a fiscal year label.
  period      String
  /// SHORT_TERM | POST_EMPLOYMENT | OTHER_LONG_TERM | TERMINATION | SHARE_BASED
  category    String
  amountMinor BigInt
  /// How many people the figure covers. Disclosing a total for "key
  /// management" without saying how many people that is tells a reader very
  /// little.
  headcount   Int
  declaredBy  String
  declaredOn  DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([orgId, entityId, period, category])
}

/// The attestation that makes the note complete: who has been assessed, by
/// whom, and whether there is a controlling party. "There are none" is a
/// declaration somebody makes, never a default the software assumes.
model RelatedPartyAttestation {
  id                      String   @id @default(cuid())
  orgId                   String
  entityId                String
  period                  String
  /// IAS 24.13: the parent and, where different, the ultimate controlling
  /// party, disclosed whether or not there were transactions between them.
  parentName              String?
  ultimateControllingParty String?
  /// True where the preparer states there is no controlling party at all,
  /// which is different from not having been asked.
  noControllingParty      Boolean  @default(false)
  attestedBy              String
  attestedOn              DateTime @db.Date
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([orgId, entityId, period])
}

/// What somebody has said about a notification: that they have seen it, or that
/// they want it back on a stated day.
///
/// Keyed on the finding's STABLE IDENTITY — which module said it, which of its
/// checks, and which particular thing it is about — never on its wording. Every
/// sentence on that screen is generated, so half of them are rewritten whenever
/// the figure inside them moves; an acknowledgement keyed on the message would
/// evaporate the first time a number changed.
///
/// The severity, count and amount here are the finding AS IT STOOD when it was
/// dealt with, and they are what makes an acknowledgement lapse. Acknowledging
/// three unreconciled bank lines is a statement about three lines; forty-seven
/// is not the thing that was acknowledged, so the row comes back.
///
/// One row per key: this is the current position, overwritten in place.
/// `NotificationEvent` is the log, and it is the thing that remembers.
model NotificationAck {
  id          String    @id @default(cuid())
  orgId       String
  entityId    String
  key         String
  /// acknowledged | snoozed
  action      String
  actorId     String
  /// Written down beside the id rather than joined at read time: an
  /// acknowledgement is a statement somebody made on a day, and it should still
  /// read as English after the account is closed.
  actorName   String?
  at          DateTime  @default(now())
  /// Optional. A reason nobody wrote is better than a reason nobody meant.
  reason      String?
  severity    String
  /// How many things it covered then, where a count means something.
  itemCount   Int?
  /// What it was worth then, in minor units.
  amountMinor BigInt?
  /// The deadline it carried then. A snooze may never reach it — the database
  /// keeps that rule itself, in NotificationAck_snooze_before_due_check.
  dueOn       DateTime? @db.Date
  /// The day a snooze runs out and the row comes back. Null for an
  /// acknowledgement, and the database holds the two to that.
  snoozeUntil DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orgId, entityId, key])
  @@index([orgId, entityId, action])
}

/// Every act on a notification, appended and never updated.
///
/// The ack row above holds only the current position, so acknowledging over a
/// snooze overwrites it. Without this log, "why did this row stop showing, and
/// who decided that" would have no answer — which is the question somebody asks
/// precisely when a notification turned out to matter.
model NotificationEvent {
  id          String    @id @default(cuid())
  orgId       String
  entityId    String
  key         String
  /// acknowledged | snoozed | cleared
  action      String
  actorId     String
  actorName   String?
  at          DateTime  @default(now())
  reason      String?
  severity    String?
  itemCount   Int?
  amountMinor BigInt?
  snoozeUntil DateTime? @db.Date

  @@index([orgId, entityId, key, at])
}


/// A trade finance facility: a letter of credit, a bank guarantee, or a trust
/// receipt.
///
/// A guarantee that has not been called is a contingent liability, not a
/// liability — IAS 37.27 forbids recognising it and IAS 37.86 requires it to
/// be disclosed. What IS recognised is the cash margin the bank holds and the
/// commission it charges.
model TradeFacility {
  id            String    @id @default(cuid())
  orgId         String
  entityId      String
  reference     String
  /// LC_IMPORT | LC_EXPORT | BANK_GUARANTEE | TRUST_RECEIPT
  kind          String
  bank          String
  /// Whom it is in favour of — the supplier on an import credit, the customer
  /// on a performance guarantee.
  beneficiary   String
  currency      String    @default("AED")
  amountMinor   BigInt
  /// Cash the bank holds against the facility. Restricted: it is an asset, and
  /// it is emphatically not cash and cash equivalents.
  marginMinor   BigInt    @default(0)
  commissionMinor BigInt  @default(0)
  issuedOn      DateTime  @db.Date
  expiresOn     DateTime  @db.Date
  /// issued | drawn | expired | cancelled
  status        String    @default("issued")
  /// What has actually been called or negotiated against it.
  drawnMinor    BigInt    @default(0)
  closedOn      DateTime? @db.Date
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  events        TradeFacilityEvent[]

  @@unique([orgId, entityId, reference])
  @@index([orgId, entityId, status, expiresOn])
}

/// Each thing that happened to a facility, so a balance can be explained.
model TradeFacilityEvent {
  id          String   @id @default(cuid())
  orgId       String
  facilityId  String
  facility    TradeFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// issue | amend | draw | settle | release | expire | cancel
  kind        String
  happenedOn  DateTime @db.Date
  amountMinor BigInt   @default(0)
  entryId     String?
  memo        String?
  createdAt   DateTime @default(now())

  @@index([orgId, facilityId, happenedOn])
}


/// A receivable written off as irrecoverable.
///
/// Kept as its own record rather than inferred from a journal, because
/// Article 64(1) of Federal Decree-Law 8/2017 makes adjusting the output tax
/// conditional on facts a journal does not hold: six months elapsed, the debt
/// written off in the books, and the customer notified.
model ReceivableWriteOff {
  id            String    @id @default(cuid())
  orgId         String
  entityId      String
  /// The document being written off.
  documentId    String
  documentRef   String
  partyKey      String
  partyName     String
  amountMinor   BigInt
  /// The output tax on it, where the supply bore any. Adjusting it is a
  /// separate decision from writing the debt off.
  vatMinor      BigInt    @default(0)
  writtenOffOn  DateTime  @db.Date
  /// Article 64(1)(a): the debt must have been outstanding six months.
  invoicedOn    DateTime  @db.Date
  reason        String
  /// Article 64(1)(c): the customer must be notified of the amount written
  /// off before the output tax may be adjusted.
  notifiedOn    DateTime? @db.Date
  /// Whether the output tax was adjusted, and on which return.
  vatAdjusted   Boolean   @default(false)
  entryId       String?
  actorId       String?
  createdAt     DateTime  @default(now())

  @@unique([orgId, entityId, documentId])
  @@index([orgId, entityId, writtenOffOn])
}

/// A counterparty somebody looked at and decided is NOT a related party.
///
/// IAS 24 completeness is the whole difficulty with the note, and a reader
/// cannot tell an assessed nil from an unasked question. This records the
/// assessment without asserting a relationship, so it clears the "never
/// assessed" list and reaches no disclosure.
model PartyAssessment {
  id         String   @id @default(cuid())
  orgId      String
  entityId   String
  partyKey   String
  name       String
  assessedBy String
  assessedOn DateTime @db.Date
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([orgId, entityId, partyKey])
  @@index([orgId, entityId])
}

/// The tax period the FTA has assigned this entity, and the filing history.
///
/// Nothing held it before, so every reminder and every "is this filed" answer
/// was inferred from the period lock — an inference the register labelled as
/// one. A registrant's VAT stagger is assigned by the FTA and is not derivable
/// from anything in the books.
model TaxRegistration {
  id            String    @id @default(cuid())
  orgId         String
  entityId      String
  /// VAT | CORPORATE_TAX | EXCISE
  regime        String
  trn           String?
  /// MONTHLY | QUARTERLY | ANNUAL
  frequency     String    @default("QUARTERLY")
  /// The month the stagger's first period ends: 1..12. A quarterly registrant
  /// assigned Feb/May/Aug/Nov has 2 here.
  firstPeriodEndMonth Int  @default(3)
  registeredOn  DateTime? @db.Date
  deregisteredOn DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  filings       TaxFiling[]

  @@unique([orgId, entityId, regime])
}

/// A return that was actually filed, so "filed" stops being an inference.
model TaxFiling {
  id             String          @id @default(cuid())
  orgId          String
  registrationId String
  registration   TaxRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  /// The period covered, as the label the return itself carries.
  periodLabel    String
  periodFrom     DateTime        @db.Date
  periodTo       DateTime        @db.Date
  dueOn          DateTime        @db.Date
  filedOn        DateTime?       @db.Date
  reference      String?
  netVatMinor    BigInt?
  filedBy        String?
  notes          String?
  createdAt      DateTime        @default(now())

  @@unique([registrationId, periodLabel])
  @@index([orgId, periodTo])
}
