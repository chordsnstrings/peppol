// ARKS e-Invoicing — multi-tenant server schema.
// Domain data (invoices, customers, entities…) is stored as tenant-scoped JSON
// documents in `Record`, so the existing client keeps its object-store shape while
// gaining server-side persistence + org isolation. Auth and secrets are typed tables.
//
// PostgreSQL. Dev runs a local cluster in-container; production points
// DATABASE_URL at managed Postgres — the app code and migrations are identical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  meta         UserMeta[]
}

model Organization {
  id              String       @id @default(cuid())
  name            String
  slug            String
  defaultLocale   String       @default("en")
  status          String       @default("active") // active | suspended | readonly
  suspendedReason String?
  createdAt       DateTime     @default(now())
  memberships     Membership[]
}

/// A platform operator (super admin). Global, NOT an org Membership role. The
/// PLATFORM_ADMINS env allowlist is the break-glass root and bootstraps rows here.
model PlatformAdmin {
  userId    String   @id
  role      String   @default("support") // super | support | read_only
  addedBy   String?
  createdAt DateTime @default(now())
}

/// Append-only log of every privileged platform-admin read/action. This is what
/// makes cross-tenant access defensible.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminEmail  String
  action      String
  targetOrgId String?
  targetId    String?
  metadata    String? // JSON — before/after, params
  reason      String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetOrgId])
  @@index([adminUserId])
}

/// Platform feature flags / kill switches. Global or per-org scope.
model FeatureFlag {
  key       String   @id // e.g. "signups_frozen" or "org:<id>:readonly"
  value     String   @default("true") // JSON or scalar
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String       @default("OWNER")
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

/// Generic tenant-scoped document store. One row per domain object.
/// Primary key is (store, id): the same id may legitimately exist in two stores
/// without colliding — a record is identified by its store *and* id.
model Record {
  id        String
  orgId     String
  store     String
  entityId  String?
  invoiceId String?
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([store, id])
  @@index([orgId, store])
  @@index([orgId, store, entityId])
  @@index([orgId, invoiceId])
}

/// Per-user preferences (current entity, locale, notification prefs, API keys…).
model UserMeta {
  userId String
  key    String
  data   String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// A document transmission through the Peppol gateway. Looked up by gatewayRef
/// on inbound webhooks (no session), so it carries orgId + invoiceId to route
/// the status update back to the right tenant's invoice.
model Transmission {
  id              String    @id @default(cuid())
  orgId           String
  invoiceId       String
  gatewayRef      String    @unique
  idempotencyKey  String    @unique
  driver          String
  exchangeStatus  String    @default("SUBMITTED")
  reportingStatus String    @default("SUBMITTED")
  ublXml          String
  tddXml          String
  error           String?
  lastEventAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
  @@index([invoiceId])
}

/// A payment attempt/collection against an invoice. `id` doubles as the public
/// pay-link token. Looked up by providerRef on gateway webhooks (no session).
model Payment {
  id          String    @id @default(cuid())
  orgId       String
  kind        String    @default("invoice") // invoice | subscription
  invoiceId   String? // null for subscription payments
  tier        String? // subscription tier when kind = subscription
  provider    String
  providerRef String?
  amountMinor Int
  currency    String
  status      String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | EXPIRED
  method      String?
  paymentUrl  String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId])
  @@index([invoiceId])
  @@index([providerRef])
}

/// The tenant's current billing plan. One row per org.
model OrgBilling {
  orgId             String   @id
  plan              String   @default("FREE_MANDATE") // legacy analytics/allowance (not the paywall)
  allowanceOverride Int? // operator comp: overrides the plan's included exchanges
  // Subscription — the paywall. Entitlement to transmit to the FTA derives ONLY
  // from these fields (server-authoritative, never client-writable).
  subStatus              String    @default("trialing") // trialing | active | grace | canceled | none
  subTier                String? // MONTHLY | SEMIANNUAL | ANNUAL
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  graceEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  providerCustomerId     String?
  providerSubscriptionId String?
  lastPaymentAt          DateTime?
  dunningStage           Int       @default(0) // which reminder emails have been sent
  updatedAt              DateTime  @updatedAt
}

/// One billable exchange event, written when an invoice is first transmitted.
/// Idempotent per (invoiceId, kind) so re-sends never double-count. Usage is a
/// COUNT over these — the authoritative meter behind the billing page.
model UsageEvent {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  invoiceId String
  kind      String   @default("EXCHANGE")
  year      Int
  createdAt DateTime @default(now())

  @@unique([invoiceId, kind])
  @@index([orgId, entityId, year])
}

/// OAuth 2.1 client, created via Dynamic Client Registration (RFC 7591) so MCP
/// clients (Claude, ChatGPT, Gemini) can self-register and sign in. Public
/// (PKCE) clients have no secret.
model OAuthClient {
  id              String   @id // client_id
  secretHash      String? // null for public PKCE clients
  name            String
  redirectUris    String // JSON array
  grantTypes      String   @default("authorization_code,refresh_token")
  tokenAuthMethod String   @default("none")
  createdAt       DateTime @default(now())
}

/// A short-lived authorization code (PKCE). Stored hashed; single-use.
model OAuthAuthCode {
  codeHash      String    @id
  clientId      String
  orgId         String
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String    @default("mcp")
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())
}

/// A refresh token (opaque, stored hashed, revocable, rotated on use).
model OAuthRefreshToken {
  tokenHash String    @id
  clientId  String
  orgId     String
  userId    String
  scope     String    @default("mcp")
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Idempotency ledger for inbound webhooks — dedup key is a hash of the source
/// + raw signed body, so a replayed (even validly-signed) webhook is a no-op.
model ProcessedWebhook {
  id        String   @id // sha256(source + rawBody)
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A programmatic API key for the public /api/v1 REST API. Only the SHA-256
/// hash is stored; the plaintext is shown once at creation. Scoped to one org.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  prefix     String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId])
}

/// Encrypted OAuth tokens for accounting integrations. Server-only, per tenant.
model IntegrationToken {
  id              String    @id // == Connection id held by the client
  orgId           String
  provider        String
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  meta            String? // JSON: providerAccountId, apiDomain, etc.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orgId])
}

/* ══════════════════════════════════════════════════════════════════════════
   LEDGER CORE — double-entry general ledger.

   The invariants that make this an accounting system rather than a table of
   rows are enforced by the DATABASE, not by application code (see the raw SQL
   in the accompanying migration): entries balance to zero per currency, posted
   entries are immutable (correction is reversal-only), and nothing posts into
   a closed period. Amounts are signed integer minor units — debit positive,
   credit negative — so "balanced" is literally SUM() = 0.
   ══════════════════════════════════════════════════════════════════════════ */

/// A set of books for a legal entity. Multi-book from day one (statutory / tax /
/// management); every entity ships with one PRIMARY book. Shipping the column now
/// avoids the retrofit that NetSuite charges Professional Services to perform.
model Book {
  id                   String         @id @default(cuid())
  orgId                String
  entityId             String
  code                 String         @default("PRIMARY")
  name                 String
  kind                 String         @default("PRIMARY") // PRIMARY | TAX | MGMT
  functionalCurrency   String         @default("AED")
  presentationCurrency String         @default("AED")
  isDefault            Boolean        @default(false)
  createdAt            DateTime       @default(now())
  entries              JournalEntry[]
  balances             AccountBalance[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId])
}

/// Chart of accounts. One chart per legal entity, shared across that entity's books.
model Account {
  id                String           @id @default(cuid())
  orgId             String
  entityId          String
  code              String
  name              String
  nameAr            String?
  type              String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  subtype           String? // BANK | AR | AP | VAT_INPUT | VAT_OUTPUT | RETAINED_EARNINGS | ...
  parentId          String?
  parent            Account?         @relation("AccountTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Account[]        @relation("AccountTree")
  /// Header accounts roll up but cannot be posted to.
  isPostable        Boolean          @default(true)
  /// Control accounts (AR/AP/VAT/bank) are owned by their subledger — manual journals are refused.
  isControl         Boolean          @default(false)
  /// Restrict postings to a single currency (bank accounts).
  currency          String?
  /// Dimension code that must be supplied on every posting to this account.
  requiresDimension String?
  status            String           @default("active") // active | archived
  createdAt         DateTime         @default(now())
  lines             JournalLine[]
  balances          AccountBalance[]

  @@unique([orgId, entityId, code])
  @@index([orgId, entityId, type])
  @@index([parentId])
}

model FiscalYear {
  id       String             @id @default(cuid())
  orgId    String
  entityId String
  label    String
  startsOn DateTime           @db.Date
  endsOn   DateTime           @db.Date
  status   String             @default("open") // open | closed
  periods  AccountingPeriod[]

  @@unique([orgId, entityId, label])
  @@index([orgId, entityId])
}

/// The fiscal calendar. Without this there is no close, and no way to stop a
/// tenant back-dating a journal into a filed VAT quarter.
model AccountingPeriod {
  id           String         @id @default(cuid())
  orgId        String
  entityId     String
  fiscalYearId String
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  seq          Int
  label        String
  startsOn     DateTime       @db.Date
  endsOn       DateTime       @db.Date
  /// open → soft_closed (reopenable) → hard_closed → locked (statutory, never reopens)
  status       String         @default("open")
  isAdjustment Boolean        @default(false)
  closedAt     DateTime?
  entries      JournalEntry[]
  balances     AccountBalance[]

  @@unique([orgId, entityId, label])
  @@index([orgId, entityId, startsOn, endsOn])
}

/// N dimensions, normalised — not two hard-coded columns. Xero's two-dimension
/// cap is its most-complained-about reporting constraint; this is free now and a
/// rewrite later.
model Dimension {
  id         String           @id @default(cuid())
  orgId      String
  code       String // COST_CENTRE | PROJECT | DEPARTMENT | BRANCH | ...
  name       String
  isRequired Boolean          @default(false)
  status     String           @default("active")
  values     DimensionValue[]

  @@unique([orgId, code])
}

model DimensionValue {
  id          String                 @id @default(cuid())
  orgId       String
  dimensionId String
  dimension   Dimension              @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  code        String
  name        String
  status      String                 @default("active")
  tags        JournalLineDimension[]

  @@unique([dimensionId, code])
  @@index([orgId])
}

model JournalEntry {
  id           String           @id @default(cuid())
  orgId        String
  entityId     String
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Restrict)
  periodId     String
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  series       String           @default("GJ")
  number       String
  entryDate    DateTime         @db.Date
  postedAt     DateTime?
  status       String           @default("draft") // draft | posted | reversed
  memo         String?
  /// Where the posting came from — manual, or a subledger document.
  source       String           @default("manual")
  sourceType   String?
  sourceId     String?
  /// Idempotency key for machine posting; a retry must not double-post.
  externalKey  String?
  /// The document this entry settles, when it settles one — a receipt names the
  /// invoice it pays. Open-item ageing nets a document's postings by this, so
  /// without it a paid invoice keeps showing as outstanding forever.
  settlesId    String?
  reversalOfId String?
  reversalOf   JournalEntry?    @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals    JournalEntry[]   @relation("EntryReversal")
  /// Provenance as a first-class column, not an afterthought log.
  actorType    String           @default("HUMAN") // HUMAN | RULE | MODEL | AGENT | INTEGRATION
  actorId      String?
  createdAt    DateTime         @default(now())
  lines        JournalLine[]

  @@unique([orgId, entityId, bookId, series, number])
  @@unique([orgId, externalKey])
  @@index([orgId, entityId, periodId])
  @@index([orgId, sourceType, sourceId])
  @@index([orgId, settlesId])
  @@index([orgId, entityId, entryDate])
}

/// Signed minor units: debit > 0, credit < 0. Three currency concepts on every
/// line, with the rate captured at posting time.
model JournalLine {
  id                    String                 @id @default(cuid())
  orgId                 String
  entryId               String
  entry                 JournalEntry           @relation(fields: [entryId], references: [id], onDelete: Cascade)
  lineNo                Int
  accountId             String
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  txnCurrency           String
  txnAmountMinor        BigInt
  fxRate                Decimal                @default(1) @db.Decimal(20, 10)
  functionalCurrency    String
  functionalAmountMinor BigInt
  /// The tax treatment this line was raised under, carried from the document.
  /// The VAT return groups by it, so the return is computed from the ledger
  /// rather than from a second pass over the documents — the two can then
  /// never disagree with each other.
  taxCode               String?
  /// Emirate of supply. The FTA's VAT 201 splits standard-rated supplies by
  /// emirate, and that is only knowable at the moment of posting.
  taxEmirate            String?
  memo                  String?
  dimensions            JournalLineDimension[]

  @@unique([entryId, lineNo])
  @@index([orgId, accountId])
  @@index([entryId])
  @@index([orgId, taxCode])
}

model JournalLineDimension {
  id          String         @id @default(cuid())
  lineId      String
  line        JournalLine    @relation(fields: [lineId], references: [id], onDelete: Cascade)
  dimensionId String
  valueId     String
  value       DimensionValue @relation(fields: [valueId], references: [id], onDelete: Restrict)

  @@unique([lineId, dimensionId])
  @@index([valueId])
}

/// Period-anchored balance cache. A balance is NEVER computed by summing the
/// whole ledger; it is maintained incrementally at post time and anchored per period.
model AccountBalance {
  id           String           @id @default(cuid())
  orgId        String
  entityId     String
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodId     String
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  currency     String
  openingMinor BigInt           @default(0)
  debitMinor   BigInt           @default(0)
  creditMinor  BigInt           @default(0)
  closingMinor BigInt           @default(0)
  updatedAt    DateTime         @updatedAt

  @@unique([bookId, accountId, periodId, currency])
  @@index([orgId, entityId, periodId])
}

/// Gapless document numbering, allocated inside the posting transaction with an
/// atomic UPDATE … RETURNING. Replaces the client-side read-modify-write that
/// hands two concurrent users the same invoice number.
model DocumentSequence {
  id        String   @id @default(cuid())
  orgId     String
  entityId  String
  scope     String
  prefix    String   @default("")
  nextNo    Int      @default(1)
  padding   Int      @default(5)
  updatedAt DateTime @updatedAt

  @@unique([orgId, entityId, scope])
}
