{
  "name": "ARKS e-Invoicing",
  "short_name": "ARKS",
  "description": "Become UAE e-invoicing compliant with near-zero friction — create, validate, transmit and archive Peppol invoices.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0B1A2E",
  "theme_color": "#0B1A2E",
  "categories": ["business", "finance", "productivity"],
  "dir": "auto",
  "lang": "en-AE",
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New invoice",
      "short_name": "New invoice",
      "description": "Create a compliant invoice",
      "url": "/invoices/new?source=pwa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Fix-it queue",
      "short_name": "Fix-it",
      "description": "See what's blocking compliance",
      "url": "/fixit?source=pwa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Upload spreadsheet",
      "short_name": "Upload",
      "description": "Import invoices from Excel/CSV",
      "url": "/uploads?source=pwa",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
