# Copy to .env and fill in.
DATABASE_URL="postgresql://arks:arks@127.0.0.1:5432/arks?schema=public"  # managed Postgres in prod
AUTH_SECRET="change-me-to-a-long-random-string"
ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Accounting integrations (optional; each falls back to a sandbox mock driver
# until its credentials are set). Redirect URI = <origin>/api/integrations/<slug>/callback

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# QuickBooks Online (Intuit)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox            # sandbox | production

# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Odoo (JSON-RPC + API key)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
