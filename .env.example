# Copy to .env and fill in. Dev defaults use SQLite and run in-container.
DATABASE_URL="file:./dev.db"          # prod: postgresql://… (managed Postgres)
AUTH_SECRET="change-me-to-a-long-random-string"
ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Zoho Books integration (optional; mock driver runs without credentials)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
