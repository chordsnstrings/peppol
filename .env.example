# Copy to .env and fill in.
DATABASE_URL="postgresql://arks:arks@127.0.0.1:5432/arks?schema=public"  # managed Postgres in prod
AUTH_SECRET="change-me-to-a-long-random-string"
ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Platform operators (super admin console at /admin). Comma/space separated
# emails permitted to become operators. Being listed is NOT enough on its own:
# an allowlisted, signed-in user must also present PLATFORM_BOOTSTRAP_TOKEN once
# at /admin-setup to be elevated to "super" (privilege is never derived from an
# unverified email). After that, supers grant teammates in-app.
PLATFORM_ADMINS=""
# One-time bootstrap secret for the operator claim at /admin-setup. Treat like a
# production secret; rotate after bootstrapping. Empty disables claiming.
PLATFORM_BOOTSTRAP_TOKEN=""

# Accounting integrations (optional; each falls back to a sandbox mock driver
# until its credentials are set). Redirect URI = <origin>/api/integrations/<slug>/callback

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# QuickBooks Online (Intuit)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox            # sandbox | production

# Xero
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Odoo (JSON-RPC + API key)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Peppol gateway / FTA transmission (ASP partner = Taxilla, Route A).
# Defaults to an in-process mock gateway that completes sends in sandbox.
GATEWAY_DRIVER=mock                 # mock | taxilla
TAXILLA_BASE_URL=                   # e.g. https://api.taxilla.com/einvoice/ae
TAXILLA_API_KEY=
TAXILLA_CLIENT_ID=
TAXILLA_WEBHOOK_SECRET=             # HMAC secret for /api/gateway/webhook

# E-commerce storefronts (import orders as compliant invoices).
# Shopify (custom/private app or OAuth)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP=                       # e.g. my-store.myshopify.com

# WooCommerce (REST API key pair)
WOO_URL=                           # e.g. https://store.example.com
WOO_KEY=
WOO_SECRET=

# Payments (collection). Defaults to a self-hosted sandbox /pay page so
# collection runs credential-free; set PAYMENT_DRIVER + that gateway's keys to go live.
PAYMENT_DRIVER=mock                 # mock | network | noqodi
# Network International (N-Genius)
NETWORK_API_BASE=                   # e.g. https://api-gateway.ngenius-payments.com
NETWORK_API_KEY=
NETWORK_OUTLET_REF=
NETWORK_WEBHOOK_SECRET=             # HMAC secret; REQUIRED for the live network driver (fail-closed)
# noqodi (hosted checkout)
NOQODI_API_BASE=                    # e.g. https://api.noqodi.com
NOQODI_API_KEY=
NOQODI_MERCHANT_ID=
NOQODI_WEBHOOK_SECRET=              # HMAC secret for /api/payments/webhook

# WhatsApp (send invoices + pay links from each tenant's own number).
# Defaults to a sandbox driver; set WHATSAPP_DRIVER=meta + a system-user token to send live.
WHATSAPP_DRIVER=mock                # mock | meta
WHATSAPP_TOKEN=                     # Meta system-user access token (platform-wide)
WHATSAPP_GRAPH_BASE=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=           # fallback sender; tenants set their own in-app
